# Example environment configuration
# Copy this file to .env and fill in your values
SECRET_KEY=replace_with_a_long_random_secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,.a.run.app,automated-review-companion.web.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://automated-review-companion.web.app
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://automated-review-companion.web.app
# For production (Cloud SQL Postgres), set DATABASE_URL.
# Example: DATABASE_URL=postgres://USER:PASSWORD@/DB_NAME?host=/cloudsql/PROJECT:REGION:INSTANCE
# DATABASE_URL=

# Daily per-IP cap on papers submitted to the LLM filter (default 300)
# MAX_LLM_CALL_COUNT=300

AZURE_RESOURCE_NAME=your_azure_resource_name
AZURE_API_KEY=your_azure_api_key
AZURE_DEPLOYMENT_NAME=your_deployment_name
SEMANTIC_SCHOLAR_KEY=your_semantic_scholar_key
WOS_KEY=your_wos_key
SCOPUS_KEY=your_scopus_key
IEEE_API_KEY=your_ieee_api_key
OPENAI_API_KEY=your_openai_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.5